#!/bin/bash
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# ── Load libraries ────────────────────────────────────
. "$DOTFILES_DIR/lib/core.sh"
. "$DOTFILES_DIR/lib/config.sh"
. "$DOTFILES_DIR/lib/module.sh"

# ── State ─────────────────────────────────────────────
PROFILE="${PROFILE:-}"
CURSOR=0
STTY_STATE=""

# ── TUI Symbols ──────────────────────────────────────
SYM_CHECK="${GREEN}◉${NC}"
SYM_UNCHECK="${DIM}○${NC}"
SYM_PTR="${CYAN}❯${NC}"

# ── Terminal ──────────────────────────────────────────
setup_term() {
    STTY_STATE=$(stty -g)
    stty -icanon -echo
    printf '\033[?25l'
    printf '\033[?1049h'
}

restore_term() {
    printf '\033[?1049l'
    printf '\033[?25h'
    [[ -n "${STTY_STATE:-}" ]] && stty "$STTY_STATE" 2>/dev/null || true
}

read_key() {
    local c
    IFS= read -r -n1 c
    case "$c" in
        $'\x1b')
            IFS= read -r -n2 -t 0.1 c || true
            case "$c" in
                '[A') printf 'up'   ;;
                '[B') printf 'down' ;;
            esac
            ;;
        ' ')   printf 'space' ;;
        ''|$'\r') printf 'enter' ;;
        a|A)   printf 'toggle_all' ;;
        q|Q)   printf 'quit' ;;
        k)     printf 'up' ;;
        j)     printf 'down' ;;
    esac
}

# ── TUI: Profile Selector (macOS) ────────────────────
select_profile() {
    local options=("personal" "work")
    local descs=(
        "Personal — includes 1Password, Karabiner, etc."
        "Work — common packages only"
    )
    local cur=0

    while true; do
        printf '\033[H\033[J'
        printf '\n'
        printf '  %bdotfiles%b  %bSelect a profile%b\n' "$BOLD" "$NC" "$DIM" "$NC"
        printf '  %b─────────────────────────────────────────────%b\n' "$DIM" "$NC"
        printf '\n'

        for i in "${!options[@]}"; do
            if ((i == cur)); then
                printf '  %b %b%s%b  %b%s%b\n' \
                    "$SYM_PTR" "$BOLD" "${options[$i]}" "$NC" "$DIM" "${descs[$i]}" "$NC"
            else
                printf '    %s  %b%s%b\n' \
                    "${options[$i]}" "$DIM" "${descs[$i]}" "$NC"
            fi
        done

        printf '\n  %b↑↓ move  enter select  q quit%b\n' "$DIM" "$NC"

        case "$(read_key)" in
            up)    ((cur > 0)) && ((cur--)) || true ;;
            down)  ((cur < ${#options[@]} - 1)) && ((cur++)) || true ;;
            enter) PROFILE="${options[$cur]}"; return 0 ;;
            quit)  return 1 ;;
        esac
    done
}

# ── TUI: Module Selector ─────────────────────────────
# 선택 상태 배열 (레지스트리와 동일 크기)
_SEL=()

select_modules() {
    CURSOR=0
    local total=${#_REG_TAGS[@]}

    # 기본: 모두 선택
    _SEL=()
    local i
    for i in "${!_REG_TAGS[@]}"; do
        _SEL+=(1)
    done

    while true; do
        printf '\033[H\033[J'

        # Header
        printf '\n'
        printf '  %bdotfiles%b  %b%s · %s%b\n' \
            "$BOLD" "$NC" "$DIM" "$OS" "${PROFILE:-default}" "$NC"
        printf '  %b─────────────────────────────────────────────%b\n' "$DIM" "$NC"
        printf '\n'
        printf '  %b↑↓ move  ␣ toggle  a all/none  enter run  q quit%b\n' "$DIM" "$NC"
        printf '\n'

        # Modules grouped by category
        local prev_cat=""
        for i in "${!_REG_TAGS[@]}"; do
            local cat="${_REG_CATEGORIES[$i]}"
            if [[ "$cat" != "$prev_cat" ]]; then
                [[ -n "$prev_cat" ]] && printf '\n'
                printf '  %b%s%b\n' "$DIM" "$cat" "$NC"
                prev_cat="$cat"
            fi

            local sym="$SYM_UNCHECK"
            ((_SEL[i])) && sym="$SYM_CHECK"

            if ((i == CURSOR)); then
                printf '  %b %b %b%s%b  %b%s%b\n' \
                    "$SYM_PTR" "$sym" "$BOLD" "${_REG_LABELS[$i]}" "$NC" \
                    "$DIM" "${_REG_DESCS[$i]}" "$NC"
            else
                printf '    %b %s  %b%s%b\n' \
                    "$sym" "${_REG_LABELS[$i]}" "$DIM" "${_REG_DESCS[$i]}" "$NC"
            fi
        done

        # Count selected
        local count=0
        for s in "${_SEL[@]}"; do ((count += s)) || true; done
        printf '\n  %b%d of %d selected%b\n' "$DIM" "$count" "$total" "$NC"

        case "$(read_key)" in
            up)    ((CURSOR > 0)) && ((CURSOR--)) || true ;;
            down)  ((CURSOR < total - 1)) && ((CURSOR++)) || true ;;
            space)
                if ((_SEL[CURSOR])); then
                    _SEL[CURSOR]=0
                else
                    _SEL[CURSOR]=1
                fi
                ;;
            toggle_all)
                local all=1
                for s in "${_SEL[@]}"; do
                    ((s == 0)) && { all=0; break; }
                done
                local val=1
                ((all)) && val=0
                for i in "${!_SEL[@]}"; do
                    _SEL[$i]=$val
                done
                ;;
            enter) return 0 ;;
            quit)  return 1 ;;
        esac
    done
}

# ── TUI: Resume Prompt ───────────────────────────────
select_resume() {
    local options=("resume" "restart" "cancel")
    local descs=(
        "Resume — continue from '$FAILED_TAG' onward (tags: $TAGS)"
        "Restart — ignore saved state, start fresh"
        "Cancel — exit without running"
    )
    local cur=0

    while true; do
        printf '\033[H\033[J'
        printf '\n'
        printf '  %bdotfiles%b  %bPrevious run failed at: %s%b\n' \
            "$BOLD" "$NC" "$YELLOW" "$FAILED_TAG" "$NC"
        printf '  %b─────────────────────────────────────────────%b\n' "$DIM" "$NC"
        printf '\n'

        for i in "${!options[@]}"; do
            if ((i == cur)); then
                printf '  %b %b%s%b  %b%s%b\n' \
                    "$SYM_PTR" "$BOLD" "${options[$i]}" "$NC" "$DIM" "${descs[$i]}" "$NC"
            else
                printf '    %s  %b%s%b\n' \
                    "${options[$i]}" "$DIM" "${descs[$i]}" "$NC"
            fi
        done

        printf '\n  %b↑↓ move  enter select  q quit%b\n' "$DIM" "$NC"

        case "$(read_key)" in
            up)    ((cur > 0)) && ((cur--)) || true ;;
            down)  ((cur < ${#options[@]} - 1)) && ((cur++)) || true ;;
            enter) printf '%s' "${options[$cur]}"; return 0 ;;
            quit)  printf 'cancel'; return 0 ;;
        esac
    done
}

# ── Sudo ─────────────────────────────────────────────
ensure_sudo() {
    if ! sudo -n true 2>/dev/null; then
        info "Sudo password required for system configuration"
        sudo -v
    fi
    # Allow passwordless sudo for dotfiles provisioning
    local sudoers_file="/etc/sudoers.d/dotfiles"
    local sudoers_rule="$(whoami) ALL=(ALL) NOPASSWD:SETENV: ALL"
    if [[ ! -f "$sudoers_file" ]] || ! grep -qF "$sudoers_rule" "$sudoers_file" 2>/dev/null; then
        sudo sh -c "echo '$sudoers_rule' > $sudoers_file && chmod 0440 $sudoers_file"
    fi
}

# ── Run Selected Modules ─────────────────────────────
run_selected() {
    local tags=()
    for i in "${!_REG_TAGS[@]}"; do
        ((_SEL[i])) && tags+=("${_REG_TAGS[$i]}")
    done

    if [[ ${#tags[@]} -eq 0 ]]; then
        printf '%bNo modules selected.%b\n' "$YELLOW" "$NC"
        return 0
    fi

    local tag_str
    tag_str=$(IFS=,; printf '%s' "${tags[*]}")

    printf '\n'
    printf '  %b❯ dotfiles%b --tags %s\n\n' "$CYAN" "$NC" "$tag_str"

    ensure_sudo
    run_modules_by_tags "$tag_str"
    local rc=$?

    if [[ $rc -ne 0 ]]; then
        # 실패한 태그 찾기 및 resume 상태 저장
        local remaining=()
        local found=0
        for t in "${tags[@]}"; do
            local state_file="$HOME/.local/state/dotfiles/${t}.done"
            if [[ ! -f "$state_file" ]] && [[ $found -eq 0 ]]; then
                found=1
                save_resume_state "${PROFILE:-default}" "$t" "$tag_str"
            fi
            if [[ $found -eq 1 ]]; then
                remaining+=("$t")
            fi
        done
        if [[ ${#remaining[@]} -gt 0 ]]; then
            local remaining_str
            remaining_str=$(IFS=,; printf '%s' "${remaining[*]}")
            save_resume_state "${PROFILE:-default}" "${remaining[0]}" "$remaining_str"
            printf '\n  %b✗ Failed at: %s%b\n' "$RED" "${remaining[0]}" "$NC"
            printf '  %bResume state saved. Run %bdotfiles --resume%b to continue.%b\n' \
                "$DIM" "$BOLD" "$DIM" "$NC"
        fi
        return 1
    fi

    clear_resume_state
}

# ── Main ──────────────────────────────────────────────
main() {
    detect_os

    case "${1:-}" in
        --help|-h)
            load_registry
            show_module_help
            return 0
            ;;
        --list)
            load_registry
            list_modules
            return 0
            ;;
        --all)
            PROFILE="${2:-}"
            if [[ -z "$PROFILE" ]]; then
                case "$OS" in
                    macos) PROFILE="personal" ;;
                    wsl)   PROFILE="wsl" ;;
                    *)     PROFILE="ubuntu" ;;
                esac
            fi
            load_config
            load_registry

            printf '\n'
            printf '  %b❯ dotfiles%b --all (profile: %s)\n\n' "$CYAN" "$NC" "$PROFILE"

            ensure_sudo

            local total=${#_REG_TAGS[@]}
            local i
            for i in "${!_REG_TAGS[@]}"; do
                run_module "$i" "$total" || {
                    local tag="${_REG_TAGS[$i]}"
                    # 남은 태그 계산
                    local remaining=()
                    local j
                    for j in "${!_REG_TAGS[@]}"; do
                        if [[ $j -ge $i ]]; then
                            remaining+=("${_REG_TAGS[$j]}")
                        fi
                    done
                    local remaining_str
                    remaining_str=$(IFS=,; printf '%s' "${remaining[*]}")
                    save_resume_state "$PROFILE" "$tag" "$remaining_str"
                    printf '\n  %b✗ Failed at: %s%b\n' "$RED" "$tag" "$NC"
                    printf '  %bResume state saved. Run %bdotfiles --resume%b to continue.%b\n' \
                        "$DIM" "$BOLD" "$DIM" "$NC"
                    return 1
                }
            done
            clear_resume_state
            return 0
            ;;
        --tags)
            [[ -z "${2:-}" ]] && { printf '%bError: --tags requires an argument%b\n' "$RED" "$NC"; exit 1; }
            PROFILE="${3:-}"
            if [[ -z "$PROFILE" ]]; then
                case "$OS" in
                    macos) PROFILE="personal" ;;
                    wsl)   PROFILE="wsl" ;;
                    *)     PROFILE="ubuntu" ;;
                esac
            fi
            load_config
            load_registry
            ensure_sudo
            run_modules_by_tags "$2"
            return $?
            ;;
        --resume)
            if ! load_resume_state; then
                printf '%bNo resume state found.%b\n' "$YELLOW" "$NC"
                return 1
            fi
            load_config
            load_registry
            printf '  %bResuming from tag: %s (tags: %s, profile: %s)%b\n' \
                "$CYAN" "$FAILED_TAG" "$TAGS" "$PROFILE" "$NC"
            ensure_sudo
            run_modules_by_tags "$TAGS"
            local rc=$?
            [[ $rc -eq 0 ]] && clear_resume_state
            return $rc
            ;;
    esac

    # ── Interactive TUI ───────────────────────────────

    # Check for resume state before entering TUI
    if [[ -f "$RESUME_FILE" ]]; then
        load_resume_state
        setup_term
        trap restore_term EXIT

        local choice
        choice=$(select_resume)

        case "$choice" in
            resume)
                restore_term; trap - EXIT
                load_config
                load_registry
                printf '  %bResuming from tag: %s (tags: %s)%b\n' \
                    "$CYAN" "$FAILED_TAG" "$TAGS" "$NC"
                ensure_sudo
                run_modules_by_tags "$TAGS"
                local rc=$?
                [[ $rc -eq 0 ]] && clear_resume_state
                return $rc
                ;;
            restart)
                clear_resume_state
                restore_term; trap - EXIT
                exec "$0"
                ;;
            cancel)
                restore_term; trap - EXIT
                printf '%bCancelled.%b\n' "$DIM" "$NC"
                return 0
                ;;
        esac
    fi

    setup_term
    trap restore_term EXIT

    case "$OS" in
        macos)
            if ! select_profile; then
                restore_term; trap - EXIT
                printf '%bCancelled.%b\n' "$DIM" "$NC"
                exit 0
            fi
            ;;
        wsl)   PROFILE="wsl" ;;
        linux) PROFILE="ubuntu" ;;
        *)
            restore_term; trap - EXIT
            printf '%bUnsupported OS.%b\n' "$RED" "$NC"
            exit 1
            ;;
    esac

    load_config
    load_registry

    if select_modules; then
        restore_term; trap - EXIT
        run_selected
    else
        restore_term; trap - EXIT
        printf '%bCancelled.%b\n' "$DIM" "$NC"
    fi
}

main "$@"
