# Editor
alias vim="nvim"
alias vi="nvim"
alias vimdiff="nvim -d"
export EDITOR="nvim"
export VISUAL="nvim"

# Claude Code
alias claude="claude --dangerously-skip-permissions"

# Container (Colima + containerd)
alias docker="nerdctl"                                                    # nerdctl은 docker CLI와 문법 호환
alias docker-start="colima start --runtime containerd && colima nerdctl install"

# tmux
alias tm="tmux"
alias tn="tmux new -s"          # tn work → 'work' 세션 새로 생성
alias ta="tmux attach -t"       # ta work → 'work' 세션 붙기
alias tl="tmux ls"              # 세션 목록
alias tk="tmux kill-session -t" # tk work → 세션 종료
alias tka="tmux kill-server"    # 전체 서버 종료
alias tas='tmux attach -t "$(basename "$PWD")" || tmux new -s "$(basename "$PWD")"'  # 현재 디렉토리 이름으로 스마트 attach/생성
alias tw="tmux new-window"
alias tsh="tmux split-window -h"
alias tsv="tmux split-window -v"
